# Copy to .env.local and fill in. Never commit .env.local.
# On Vercel, set the same names under Project Settings -> Environment Variables.

# --- Public site URL (Required in production for email links) ---
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- SMTP (e.g. Brevo SMTP relay: smtp-relay.brevo.com, port 587) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Must be on a domain you own with SPF/DKIM set up, e.g. "Quà Tặng <no-reply@yourdomain.vn>"
MAIL_FROM=

# --- Gemini (a dedicated key with billing enabled, not a free-tier key) ---
GEMINI_API_KEY=
# Pick a Flash / Flash-Lite model id from Google's current model list.
GEMINI_MODEL=

# --- Monitoring ---
# Long random string. The uptime monitor calls /api/health?token=<this>.
HEALTH_TOKEN=

# --- Auth ---
# Signs the gift-access cookies (buyer / recipient sessions). Long random string, >= 32 chars
# (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`). Required in production.
AUTH_SECRET=
# Staff log in with Supabase Auth (Dashboard -> Authentication). Create the admin account with:
#   node --env-file=.env.local scripts/create-admin.mjs <email> --password <at least 10 chars>
# and turn off "Allow new users to sign up" in the Dashboard so nobody else can register.

# --- SePay webhook (SePay dashboard -> Webhooks -> API Key) ---
SEPAY_API_KEY=

# --- Public donation account (shown as a VietQR on the home page; same account linked to SePay) ---
# NEXT_PUBLIC_DONATION_BANK is the bank code/name SePay uses in its QR (e.g. MBBank, Vietcombank).
NEXT_PUBLIC_DONATION_BANK=
NEXT_PUBLIC_DONATION_ACCOUNT=
NEXT_PUBLIC_DONATION_NAME=
