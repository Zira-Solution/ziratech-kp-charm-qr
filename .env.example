# Copy to .env.local and fill in. Never commit .env.local.
# On Vercel, set the same names under Project Settings -> Environment Variables.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (R2 -> Manage API tokens, Object Read & Write on one bucket) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- SMTP (e.g. Brevo SMTP relay: smtp-relay.brevo.com, port 587) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Must be on a domain you own with SPF/DKIM set up, e.g. "Quà Tặng <no-reply@yourdomain.vn>"
MAIL_FROM=

# --- Gemini (a dedicated key with billing enabled, not a free-tier key) ---
GEMINI_API_KEY=
# Pick a Flash / Flash-Lite model id from Google's current model list.
GEMINI_MODEL=

# --- Monitoring ---
# Long random string. The uptime monitor calls /api/health?token=<this>.
HEALTH_TOKEN=
