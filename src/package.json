{
  "name": "ssg",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --no-warnings --test scripts/*.test.ts",
    "check:fast": "tsc --noEmit && eslint && node scripts/floor-guard.mjs && gitleaks detect --source .. --redact --no-banner",
    "check:task": "npm run check:fast && npm test",
    "check:web": "node scripts/check-web.mjs",
    "check:cards": "node scripts/accept-cards.mjs",
    "check:full": "npm run check:task && osv-scanner scan source -r . && npm run check:web"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "canvas-confetti": "^1.9.4",
    "next": "16.3.8",
    "nodemailer": "^10.0.13",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "lighthouse": "^13.5.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
